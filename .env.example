DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: set your personal server's ID to deploy commands only to that
# server while testing (instant updates). Leave empty for a global deployment
# (propagation up to 1h) once you move to your friends' server.
DISCORD_GUILD_ID=

# Optional: only needed to resolve Spotify links in /play. Create an app at
# https://developer.spotify.com/dashboard (any redirect URI works, it's unused)
# and copy its Client ID / Client Secret. Without these, Spotify links just
# won't resolve — YouTube links and search still work.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
